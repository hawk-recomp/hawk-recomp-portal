/* HAWK V4 - asset-specific adjustments */
.hero { min-height: clamp(540px, 42vw, 690px); }
.hero-background {
  background-color: #060b11;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center 40%;
}
.hero-content { padding-block: clamp(44px, 6vw, 95px) 60px; }
.fifa-logo-image {
  display: block;
  width: clamp(240px, 31vw, 460px);
  max-width: 100%;
  height: auto;
  margin: 20px 0 12px;
  object-fit: contain;
  object-position: left center;
  filter: drop-shadow(0 6px 18px rgba(0,0,0,.48));
}
/* BLACK is panoramic; preserve its entire original composition. */
.project-card:has(img[src*="black-art"]) img {
  object-fit: contain;
  object-position: center;
  background: #080d15;
}
@media (max-width: 700px) {
