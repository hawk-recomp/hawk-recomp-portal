---
<a class="skip" href="#main">Skip to content</a>
<header class="header"><div class="bar shell"><a class="brand" href={pt?portuguese:home} aria-label="HAWK Recomp home"><img class="brand-logo-official" src="/hawk-recomp-portal/images/hawk-logo-official.png" alt="HAWK Recomp" width="1280" height="1280" /></a><nav aria-label="Main navigation"><a class="current" href={pt?portuguese:home}>{labels.home}</a><a href="#projects">{labels.projects}</a><a href="#research">{labels.research}</a><a href="#community">{labels.community}</a><a href="#about">{labels.about}</a><a href={pt ? `${base}/pt-br/launcher/` : `${base}/launcher/`}>{pt ? "Launcher" : "Launcher"}</a></nav><div class="tools"><label class="search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="7"/><path d="m16 16 5 5"/></svg><input id="search" type="search" placeholder={labels.search} aria-label={labels.search}/><kbd>Ctrl K</kbd></label><details class="lang"><summary aria-label="Select language"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c-6 5-6 13 0 18M12 3c6 5 6 13 0 18"/></svg>{pt?'PT-BR':'EN-US'}<span>⌄</span></summary><div class="lang-options"><a href={home} aria-current={!pt?'page':undefined}>English (US)</a><a href={portuguese} aria-current={pt?'page':undefined}>Português (Brasil)</a></div></details><a class="git" href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1a11 11 0 0 0-3.48 21.44c.55.11.75-.24.75-.53v-2c-3.06.66-3.7-1.3-3.7-1.3-.5-1.27-1.23-1.61-1.23-1.61-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.66 2.57 1.18 3.2.9.1-.72.38-1.2.69-1.47-2.44-.28-5.01-1.22-5.01-5.43 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.91 0 0 .92-.3 3.01 1.12a10.5 10.5 0 0 1 5.48 0c2.08-1.42 3-1.12 3-1.12.6 1.51.22 2.63.11 2.91.7.77 1.13 1.75 1.13 2.95 0 4.22-2.57 5.14-5.02 5.42.4.34.75 1 .75 2.04v2.65c0 .29.2.64.76.53A11 11 0 0 0 12 1Z"/></svg></a></div></div></header>
<main id="main"><section class="hero" id="featured"><div class="hero-background" style={`background-image:linear-gradient(90deg,#060b11 0%,rgba(6,11,17,.96) 18%,rgba(6,11,17,.76) 42%,rgba(6,11,17,.1) 75%),url('${image('hero-art')}')`}></div><div class="shell hero-content"><div class="kicker">{labels.featured}</div><p class="platform">{labels.heroLabel}</p><img class="fifa-logo-image" src={image("fifa-street2-logo")} alt="FIFA Street 2" width="1905" height="808" fetchpriority="high" /><h1>{labels.headline}</h1><p class="hero-desc">{labels.intro}</p><div class="hero-buttons"><a class="cta" href="https://github.com/jv36/fifastreet2-recomp" target="_blank" rel="noopener noreferrer">{labels.view}<span>→</span></a><a class="secondary" href="#about">{labels.learn}</a></div><div class="hero-meta"><span>♧ Original Xbox</span><span>⊞ Windows x64</span><span>⚗ {labels.exp}</span><a href="https://github.com/jv36/fifastreet2-recomp" target="_blank" rel="noopener noreferrer">↗ GitHub</a></div></div><div class="dots" aria-hidden="true"><span></span><span></span><span></span></div></section>
<section class="featured shell" id="projects"><div class="sectionhead"><h2>{labels.featureTitle}</h2><a href="#projects">{labels.viewAll} <span>→</span></a></div><div class="catalogue-heading">
  <p>{pt ? 'Catálogo de interesse da comunidade — prioridade editorial, não disponibilidade para jogar.' : 'Community interest catalogue — editorial priority, not a playable-games list.'}</p>
  <label for="priority-filter">{pt ? 'Prioridade' : 'Priority'}
    <select id="priority-filter" aria-label={pt ? 'Filtrar prioridade' : 'Filter priority'}>
      <option value="all">{pt ? 'Todas' : 'All'}</option>
      <option value="Alta">{pt ? 'Alta' : 'High'}</option>
      <option value="Média">{pt ? 'Média' : 'Medium'}</option>
      <option value="Baixa">{pt ? 'Baixa' : 'Low'}</option>
      <option value="Referência">{pt ? 'Referência' : 'Reference'}</option>
    </select>
  </label>
</div>
<div class="project-grid">
  {games.map((g, i) => (
    <article class={`project-card catalogue-card ${i === 0 ? 'selected' : ''}`} data-title={`${g.title} ${g.platforms}`.toLowerCase()} data-priority={g.priority}>
      {(g.cover || g.img) ? (
        <img src={g.cover || image(g.img)} alt={g.title} loading="lazy" />
      ) : (
        <div class="catalogue-placeholder" aria-hidden="true"><span>{String(i + 1).padStart(2, '0')}</span><strong>{g.title}</strong></div>
      )}
      <div class="card-body">
        <h3><a class="hawk-detail-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/${pt ? "pt-br/" : ""}games/${g.slug}/`}>{g.title}</a></h3>
        <span class="catalogue-priority">{pt ? 'Prioridade' : 'Priority'}: {pt ? g.priority : ({'Alta':'High','Média':'Medium','Baixa':'Low','Referência':'Reference'}[g.priority])}</span>
        <small>{g.platforms}</small>
        <small class="catalogue-note" title={g.projectNote}>{g.projectNote}</small>
        <span class="catalogue-state">{g.status ? (g.status === 'Community Port' ? (pt ? 'Port comunitário' : 'Community port') : g.status === 'Experimental' ? 'Experimental' : g.status) : (pt ? 'Port não verificado' : 'Port not verified')}</span>
        {g.url ? <a class="catalogue-source" href={g.url} target="_blank" rel="noopener noreferrer">{pt ? 'Ver repositório ↗' : 'View repository ↗'}</a> : (g.relatedUrl ? <a class="catalogue-source" href={g.relatedUrl} target="_blank" rel="noopener noreferrer">{pt ? 'Projeto relacionado (outro jogo/edição) ↗' : 'Related project (other game/edition) ↗'}</a> : null)}
      </div>
    </article>
  ))}
</div>
<p id="no-results" hidden>{labels.noResults}</p></section>
<section class="editorial shell" id="about"><article class="editorial-card"><img src={image('mission-art')} alt="" loading="lazy"/><div><span class="caption">{labels.missionLabel}</span><h2>{labels.missionTitle}</h2><p>{labels.missionDesc}</p><a href="https://github.com/hawk-recomp" target="_blank" rel="noopener noreferrer">{labels.missionLink} →</a></div></article><article class="editorial-card" id="research"><img src={image('research-art')} alt="" loading="lazy"/><div><span class="caption">{labels.researchLabel}</span><h2>{labels.researchTitle}</h2><p>{labels.researchDesc}</p><a href="https://github.com/jv36/fifastreet2-recomp" target="_blank" rel="noopener noreferrer">{labels.researchLink} →</a></div></article><article class="editorial-card" id="community"><img src={image('community-art')} alt="" loading="lazy"/><div><span class="caption">{labels.communityLabel}</span><h2>{labels.communityTitle}</h2><p>{labels.communityDesc}</p><a href={github} target="_blank" rel="noopener noreferrer">{labels.join} →</a></div></article></section>
<section class="proof shell"><div><b><img src="/hawk-recomp-portal/images/icon-projetos-reais.png" alt="" loading="lazy" /></b><p>{labels.proof1}<small>{labels.proof1b}</small></p></div><div><b><img src="/hawk-recomp-portal/images/icon-comunidade.png" alt="" loading="lazy" /></b><p>{labels.proof2}<small>{labels.proof2b}</small></p></div><div><b><img src={image('icon-projects')} alt="" loading="lazy" /></b><p>{labels.proof3}<small>{labels.proof3b}</small></p></div></section></main><footer><div class="shell footer-row"><span>© {new Date().getFullYear()} HAWK RECOMP</span><p>{labels.disclaimer}</p><a href={github}>GitHub ↗</a></div></footer>
<script>
  const input = document.querySelector<HTMLInputElement>('#search');
  const filter = document.querySelector<HTMLSelectElement>('#priority-filter');
  const cards = [...document.querySelectorAll<HTMLElement>('.project-card')];
  const noResults = document.querySelector<HTMLElement>('#no-results');
  function updateCatalog() {
    const query = (input?.value || '').trim().toLocaleLowerCase();
    const priority = filter?.value || 'all';
    let visible = 0;
    cards.forEach(card => {
      const matchesSearch = (card.dataset.title || '').toLocaleLowerCase().includes(query);
      const matchesPriority = priority === 'all' || card.dataset.priority === priority;
      card.hidden = !(matchesSearch && matchesPriority);
      if (!card.hidden) visible++;
    });
    if (noResults) noResults.hidden = visible > 0;
  }
  input?.addEventListener('input', updateCatalog);
  filter?.addEventListener('change', updateCatalog);
  window.addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      input?.focus();
    }
  });
</script>
