---
interface Props { locale: 'en' | 'pt'; }
const {locale} = Astro.props;
const pt = locale === 'pt';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`; const portuguese = `${base}/pt-br/`;
const image = (name: string) => `${base}/images/${name}.webp`;
const github = 'https://github.com/hawk-recomp';
const labels = pt ? {
 home:'Início',projects:'Projetos',research:'Pesquisa',community:'Comunidade',about:'Sobre',search:'Buscar jogos e projetos...',
 featured:'PROJETO EM DESTAQUE',heroLabel:'XBOX ORIGINAL · RECOMPILAÇÃO NATIVA',headline:'O futebol de rua clássico. Rumo ao PC.',intro:'Acompanhe a pesquisa comunitária para recompilar FIFA Street 2 do Xbox original para Windows. O port ainda é experimental.',view:'Ver projeto',learn:'Saiba mais',exp:'Experimental',communityPort:'Port comunitário', researchStatus:'Pesquisa',
 featureTitle:'Projetos em destaque',viewAll:'Ver todos',missionLabel:'NOSSA MISSÃO',missionTitle:'Preservando jogos. Reconstruindo experiências.',missionDesc:'Iniciativa independente voltada à recompilação nativa, pesquisa e documentação para preservação de jogos.',missionLink:'Conhecer a iniciativa',researchLabel:'PESQUISA TÉCNICA',researchTitle:'Do console para o PC',researchDesc:'Investigamos formatos executáveis, runtimes e ferramentas para apoiar ports nativos.',researchLink:'Explorar pesquisa',communityLabel:'COMUNIDADE',communityTitle:'Desenvolvimento aberto',communityDesc:'Contribua com pesquisa, testes, tradução, documentação e melhorias.',join:'Contribuir no GitHub',proof1:'Projetos reais',proof1b:'Com fontes verificáveis',proof2:'Comunidade',proof2b:'Aberta e transparente',proof3:'Documentação',proof3b:'Pesquisa e preservação',disclaimer:'HAWK Recomp é independente e não distribui ROMs, ISOs ou arquivos comerciais. Imagens desta prévia são conceituais, não capturas de gameplay.',original:'Projeto original',status:'Status',available:'Disponível no GitHub',noResults:'Nenhum projeto encontrado.'
} : {
 home:'Home',projects:'Projects',research:'Research',community:'Community',about:'About',search:'Search games, projects, guides...',
 featured:'FEATURED PROJECT',heroLabel:'ORIGINAL XBOX · NATIVE RECOMPILATION',headline:'Classic street football. A new path to PC.',intro:'Follow community research to recompile FIFA Street 2 from the original Xbox for Windows. This port is still experimental.',view:'View Project',learn:'Learn More',exp:'Experimental',communityPort:'Community Port',researchStatus:'Research',
 featureTitle:'Featured Projects',viewAll:'View all projects',missionLabel:'OUR MISSION',missionTitle:'Preserving games. Rebuilding experiences.',missionDesc:'An independent initiative supporting native recompilation, research and documentation for game preservation.',missionLink:'About the initiative',researchLabel:'TECHNICAL RESEARCH',researchTitle:'From Console to PC',researchDesc:'We investigate binary formats, runtimes and tooling to support native ports.',researchLink:'Explore research',communityLabel:'COMMUNITY',communityTitle:'Open development',communityDesc:'Contribute research, testing, translations, documentation and improvements.',join:'Contribute on GitHub',proof1:'Real projects',proof1b:'With verifiable sources',proof2:'Community driven',proof2b:'Open and transparent',proof3:'Documentation',proof3b:'For research and preservation',disclaimer:'HAWK Recomp is independent and does not distribute ROMs, ISOs, or commercial game files. Preview imagery is conceptual, not gameplay footage.',original:'Original project',status:'Status',available:'Available on GitHub',noResults:'No projects found.'
};
const games = [
 {title:'FIFA Street 2',status:labels.exp,kind:'experimental',img:'fs2-art',url:'https://github.com/jv36/fifastreet2-recomp',verified:true},
 {title:'BLACK',status:labels.communityPort,kind:'community',img:'black-art',url:'https://github.com/TGP482/BLACK-XBERecomp',verified:true}
];
---
<a class="skip" href="#main">Skip to content</a>
<header class="header"><div class="bar shell"><a class="brand" href={pt?portuguese:home} aria-label="HAWK Recomp home"><img src={image('hawk-crest')} alt="" width="57" height="57"/><div class="brandwords"><div>HAWK<span>RECOMP</span></div><small>NATIVE GAME RECOMPILATION</small></div></a><nav aria-label="Main navigation"><a class="current" href={pt?portuguese:home}>{labels.home}</a><a href="#projects">{labels.projects}</a><a href="#research">{labels.research}</a><a href="#community">{labels.community}</a><a href="#about">{labels.about}</a></nav><div class="tools"><label class="search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="7"/><path d="m16 16 5 5"/></svg><input id="search" type="search" placeholder={labels.search} aria-label={labels.search}/><kbd>Ctrl K</kbd></label><details class="lang"><summary aria-label="Select language"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c-6 5-6 13 0 18M12 3c6 5 6 13 0 18"/></svg>{pt?'PT-BR':'EN-US'}<span>⌄</span></summary><div class="lang-options"><a href={home} aria-current={!pt?'page':undefined}>English (US)</a><a href={portuguese} aria-current={pt?'page':undefined}>Português (Brasil)</a></div></details><a class="git" href={github} target="_blank" rel="noopener noreferrer" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 1a11 11 0 0 0-3.48 21.44c.55.11.75-.24.75-.53v-2c-3.06.66-3.7-1.3-3.7-1.3-.5-1.27-1.23-1.61-1.23-1.61-1-.68.08-.67.08-.67 1.1.08 1.68 1.13 1.68 1.13.98 1.66 2.57 1.18 3.2.9.1-.72.38-1.2.69-1.47-2.44-.28-5.01-1.22-5.01-5.43 0-1.2.43-2.18 1.13-2.95-.11-.28-.49-1.4.11-2.91 0 0 .92-.3 3.01 1.12a10.5 10.5 0 0 1 5.48 0c2.08-1.42 3-1.12 3-1.12.6 1.51.22 2.63.11 2.91.7.77 1.13 1.75 1.13 2.95 0 4.22-2.57 5.14-5.02 5.42.4.34.75 1 .75 2.04v2.65c0 .29.2.64.76.53A11 11 0 0 0 12 1Z"/></svg></a></div></div></header>
<main id="main"><section class="hero" id="featured"><div class="hero-background" style={`background-image:linear-gradient(90deg,#060b11 0%,rgba(6,11,17,.96) 18%,rgba(6,11,17,.76) 42%,rgba(6,11,17,.1) 75%),url('${image('hero-art')}')`}></div><div class="shell hero-content"><div class="kicker">{labels.featured}</div><p class="platform">{labels.heroLabel}</p><img class="fifa-logo-image" src={image("fifa-street2-logo")} alt="FIFA Street 2" width="1905" height="808" fetchpriority="high" /><h1>{labels.headline}</h1><p class="hero-desc">{labels.intro}</p><div class="hero-buttons"><a class="cta" href="https://github.com/jv36/fifastreet2-recomp" target="_blank" rel="noopener noreferrer">{labels.view}<span>→</span></a><a class="secondary" href="#about">{labels.learn}</a></div><div class="hero-meta"><span>♧ Original Xbox</span><span>⊞ Windows x64</span><span>⚗ {labels.exp}</span><a href="https://github.com/jv36/fifastreet2-recomp" target="_blank" rel="noopener noreferrer">↗ GitHub</a></div></div><div class="dots" aria-hidden="true"><span></span><span></span><span></span></div></section>
<section class="featured shell" id="projects"><div class="sectionhead"><h2>{labels.featureTitle}</h2><a href="#projects">{labels.viewAll} <span>→</span></a></div><div class="project-grid">{games.map((g,i)=><a class={`project-card ${i===0?'selected':''}`} href={g.url} target="_blank" rel="noopener noreferrer" data-title={g.title.toLowerCase()}><img src={image(g.img)} alt={`Concept visual for ${g.title}`} loading="lazy"/><div class="card-body"><h3>{g.title}</h3><span class={`pill ${g.kind}`}>⚗ {g.status}</span><small>Original Xbox → Windows</small></div><span class="circle-arrow">›</span></a>)}</div><p id="no-results" hidden>{labels.noResults}</p></section>
<section class="editorial shell" id="about"><article class="editorial-card"><img src={image('mission-art')} alt="" loading="lazy"/><div><span class="caption">{labels.missionLabel}</span><h2>{labels.missionTitle}</h2><p>{labels.missionDesc}</p><a href="https://github.com/hawk-recomp" target="_blank" rel="noopener noreferrer">{labels.missionLink} →</a></div></article><article class="editorial-card" id="research"><img src={image('research-art')} alt="" loading="lazy"/><div><span class="caption">{labels.researchLabel}</span><h2>{labels.researchTitle}</h2><p>{labels.researchDesc}</p><a href="https://github.com/jv36/fifastreet2-recomp" target="_blank" rel="noopener noreferrer">{labels.researchLink} →</a></div></article><article class="editorial-card" id="community"><img src={image('community-art')} alt="" loading="lazy"/><div><span class="caption">{labels.communityLabel}</span><h2>{labels.communityTitle}</h2><p>{labels.communityDesc}</p><a href={github} target="_blank" rel="noopener noreferrer">{labels.join} →</a></div></article></section>
<section class="proof shell"><div><b><img src={image('icon-projects')} alt="" loading="lazy" /></b><p>{labels.proof1}<small>{labels.proof1b}</small></p></div><div><b><img src={image('icon-projects')} alt="" loading="lazy" /></b><p>{labels.proof2}<small>{labels.proof2b}</small></p></div><div><b><img src={image('icon-projects')} alt="" loading="lazy" /></b><p>{labels.proof3}<small>{labels.proof3b}</small></p></div></section></main><footer><div class="shell footer-row"><span>© {new Date().getFullYear()} HAWK RECOMP</span><p>{labels.disclaimer}</p><a href={github}>GitHub ↗</a></div></footer>
<script>const input=document.querySelector<HTMLInputElement>('#search');const cards=[...document.querySelectorAll<HTMLElement>('.project-card')];input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let visible=0;cards.forEach(c=>{c.hidden=!c.dataset.title?.includes(q);if(!c.hidden)visible++});const no=document.querySelector<HTMLElement>('#no-results');if(no)no.hidden=visible!==0});window.addEventListener('keydown',e=>{if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='k'){e.preventDefault();input?.focus()}});</script>
<style>
:global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#070d15;color:#f5f7fb;font-family:Inter,Segoe UI,Arial,sans-serif}:global(a){text-decoration:none;color:inherit}:global(button),:global(input){font:inherit}:global(.shell){width:min(1460px,calc(100% - 88px));margin-inline:auto}.skip{position:absolute;left:-9999px}.skip:focus{left:12px;top:12px;z-index:100;background:#fac92c;color:#000;padding:12px}.header{background:#080e17;border-bottom:1px solid #233145;position:relative;z-index:5}.bar{height:78px;display:flex;align-items:center;justify-content:space-between;gap:22px}.brand{display:flex;align-items:center;gap:12px;flex-shrink:0}.brand img{width:70px;height:70px;object-fit:contain;border-radius:50%}.brandwords div{font:900 32px/.95 'Barlow Condensed',Impact,sans-serif;letter-spacing:-.015em;font-style:italic}.brandwords div span{color:#ffc623}.brandwords small{font-size:10px;letter-spacing:.14em;font-weight:750;white-space:nowrap}.bar nav{height:100%;display:flex;gap:34px;align-items:center}.bar nav a{font-size:13px;height:100%;display:grid;place-items:center;position:relative;white-space:nowrap}.bar nav a:hover,.bar nav a.current{color:#ffcf33}.bar nav .current:after{content:'';position:absolute;bottom:16px;left:0;right:0;background:#ffcf33;height:3px}.tools{display:flex;align-items:center;gap:16px}.search{height:43px;border:1px solid #263749;border-radius:10px;display:flex;align-items:center;gap:11px;padding:0 11px;min-width:230px;width:290px}.search svg,.lang svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:2}.search input{border:0;outline:0;min-width:0;width:100%;background:none;color:white;font-size:12px}.search kbd{font-size:10px;color:#768ba7;background:#1b2738;padding:3px 5px;border-radius:4px;white-space:nowrap}.lang{position:relative}.lang summary{list-style:none;display:flex;align-items:center;gap:12px;border:1px solid #263749;border-radius:10px;padding:11px 13px;font-size:12px;cursor:pointer;white-space:nowrap}.lang summary::-webkit-details-marker{display:none}.lang-options{position:absolute;top:calc(100% + 8px);right:0;background:#111e2d;border:1px solid #324152;min-width:192px;padding:6px;border-radius:10px;box-shadow:0 18px 30px #0009}.lang-options a{display:block;padding:11px;border-radius:6px;font-size:12px}.lang-options a:hover,.lang-options [aria-current]{background:#27364a;color:#ffce37}.git{width:43px;height:43px;border-radius:50%;display:grid;place-items:center;border:1px solid #263749}.git svg{width:22px;height:22px}.hero{position:relative;min-height:450px;border-bottom:1px solid #263445;overflow:hidden}.hero-background{position:absolute;inset:0;background-size:cover;background-position:center center;filter:saturate(1.05)}.hero-content{position:relative;padding-block:34px 45px}.kicker,.caption{font-size:10px;font-weight:900;letter-spacing:.15em;color:#ffd02b}.kicker:before{content:'';display:inline-block;height:18px;width:4px;border-radius:2px;background:#ffd02b;vertical-align:middle;margin-right:13px}.platform{font-size:10px;letter-spacing:.22em;color:#a9bbcf;font-weight:700;margin-top:19px}.fifa-logo{font:900 italic clamp(49px,5.5vw,81px)/.93 'Barlow Condensed',Impact,sans-serif;letter-spacing:-.045em;text-shadow:0 5px 12px #000;max-width:485px;transform:skew(-4deg);margin:13px 0 18px}.fifa-logo em{color:white;font-style:inherit}.fifa-logo b{color:#e83e24;font-size:1.3em}.hero h1{font-size:clamp(23px,2.2vw,30px);margin:6px 0;color:white;max-width:650px}.hero-desc{font-size:14px;line-height:1.6;color:#bbc8d5;max-width:525px;margin:6px 0 17px}.hero-buttons{display:flex;gap:13px;align-items:center}.cta,.secondary{min-width:145px;padding:13px 20px;border-radius:8px;text-align:center;font-size:13px;font-weight:800}.cta{background:#ffcd34;color:#071018;display:flex;align-items:center;justify-content:space-between;gap:16px}.secondary{background:#08101b91;border:1px solid #c3cedc}.hero-meta{display:flex;gap:27px;flex-wrap:wrap;margin-top:22px;color:#a1b1c2;font-size:11px}.hero-meta a:hover{color:#ffd23c}.dots{position:absolute;right:6%;bottom:21px;display:flex;gap:7px}.dots span{height:7px;width:7px;background:#586171;border-radius:100%}.dots span:first-child{background:#ffd037}.featured{padding-block:25px 37px}.sectionhead{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}.sectionhead h2{font-size:24px;margin:0;letter-spacing:-.03em}.sectionhead h2:before{content:'';width:5px;height:26px;background:#ffc92c;border-radius:2px;display:inline-block;vertical-align:middle;margin-right:15px}.sectionhead a{font-size:12px;color:#80bfff}.sectionhead a span{margin-left:12px}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.project-card{height:145px;position:relative;display:flex;align-items:center;gap:18px;background:#0d1520;border:1px solid #304153;border-radius:11px;overflow:hidden;padding:7px 48px 7px 7px;min-width:0}.project-card.selected,.project-card:hover{border-color:#ffd02f;box-shadow:0 0 0 1px #ffd02f40}.project-card[hidden]{display:none}.project-card img{height:100%;width:155px;object-fit:cover;border-radius:7px;flex-shrink:0
    object-fit: contain;
    background: #080d15;
  }.card-body{min-width:0}.card-body h3{font-size:18px;margin:0 0 12px}.pill{font-size:11px;border-radius:4px;padding:6px 9px;background:#392e10;color:#ffcf43;display:inline-block}.pill.community{background:#132d47;color:#8bc6ff}.card-body small{display:block;font-size:11px;color:#9dacbf;margin-top:12px}.circle-arrow{position:absolute;right:12px;top:50%;transform:translateY(-50%);width:35px;height:35px;display:grid;place-items:center;font-size:28px;border-radius:50%;background:#202c3d}.editorial{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px;padding-block:18px 36px}.editorial-card{position:relative;min-height:230px;border:1px solid #2d3f51;border-radius:11px;overflow:hidden;background:#111e2b}.editorial-card:before{content:'';position:absolute;inset:0;background:linear-gradient(90deg,#09111af5 4%,#09111aa8 60%,#09111a40)}.editorial-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.63}.editorial-card>div{position:relative;padding:25px 20px 20px 34%;display:flex;flex-direction:column;align-items:start;min-height:230px}.editorial-card h2{font-size:20px;line-height:1.15;margin:10px 0 7px}.editorial-card p{font-size:11px;line-height:1.65;color:#c2cfdb;margin:0 0 12px}.editorial-card a{margin-top:auto;border:1px solid #9aaec2;padding:10px 12px;border-radius:7px;font-size:11px;font-weight:800}.proof{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding-block:23px;border-top:1px solid #253345}.proof>div{display:flex;align-items:center;gap:17px}.proof b{display:grid;place-items:center;height:43px;width:43px;border-radius:50%;background:#1a293a;font-size:21px}.proof p{font-size:12px;margin:0}.proof small{display:block;color:#a3b1c3;font-size:11px;margin-top:6px}footer{border-top:1px solid #263547;color:#8497ad;font-size:11px}.footer-row{display:flex;gap:25px;align-items:center;justify-content:space-between;padding-block:25px}.footer-row p{max-width:700px;text-align:center;line-height:1.5;margin:0}
@media(max-width:1280px){.bar nav{gap:17px}.search{width:210px;min-width:150px}.editorial-card>div{padding-left:26%}}@media(max-width:1080px){.bar{height:auto;min-height:72px;flex-wrap:wrap;padding-block:8px}.bar nav{order:3;width:100%;justify-content:center;height:35px}.bar nav a.current:after{bottom:0}.project-card img{width:110px}.editorial{grid-template-columns:1fr}.editorial-card>div{padding-left:38%;min-height:190px}.editorial-card{min-height:190px}}
@media(max-width:700px){:global(.shell){width:calc(100% - 32px)}.brand img{width:49px;height:49px}.brandwords div{font-size:25px}.brandwords small{font-size:8px}.bar{gap:10px}.bar nav{overflow:auto;justify-content:flex-start;gap:20px}.bar nav a{font-size:12px}.tools{gap:8px}.search{order:5;width:100%;min-width:100%;height:36px}.search kbd{display:none}.lang summary{padding:8px;gap:5px}.git{width:36px;height:36px}.hero{min-height:510px}.hero-background{background-position:60% center!important;opacity:.64}.hero-content{padding-block:32px 50px}.hero h1{font-size:26px;max-width:370px}.hero-desc{max-width:350px}.hero-meta{gap:13px;font-size:10px}.fifa-logo{font-size:58px}.project-grid{grid-template-columns:1fr}.project-card{height:118px}.project-card img{width:118px}.sectionhead h2{font-size:21px}.sectionhead a{font-size:11px}.editorial-card>div{padding-left:34%}.proof{grid-template-columns:1fr;gap:18px}.footer-row{flex-direction:column;text-align:center}}@media(max-width:390px){.brandwords div{font-size:22px}.brand img{width:40px;height:40px}.project-card img{width:95px}.card-body h3{font-size:15px}.editorial-card>div{padding-left:26%;padding-right:10px}}@media(prefers-reduced-motion:reduce){:global(html){scroll-behavior:auto}}
/* HAWK V4 - asset-specific adjustments */
.hero { min-height: clamp(540px, 42vw, 690px); }
.hero-background {
  background-color: #060b11;
  background-repeat: no-repeat;
  background-size: cover;
  background-position: center 40%;
}
.hero-content { padding-block: clamp(44px, 6vw, 95px) 60px; }
.fifa-logo-image {
  display: block;
  width: clamp(240px, 31vw, 460px);
  max-width: 100%;
  height: auto;
  margin: 20px 0 12px;
  object-fit: contain;
  object-position: left center;
  filter: drop-shadow(0 6px 18px rgba(0,0,0,.48));
}
/* BLACK is panoramic; preserve its entire original composition. */
.project-card:has(img[src*="black-art"]) img {
  object-fit: contain;
  object-position: center;
  background: #080d15;
}
@media (max-width: 700px) {
  .hero { min-height: 540px; }
  .hero-background {
    background-size: auto 100%;
    background-position: 53% center !important;
    opacity: .56;
  }
  .hero-content { padding-block: 36px 48px; }
  .fifa-logo-image { width: min(78vw, 330px); margin: 18px 0 10px; }
}
/* HAWK V5 visual */
/* Hero covers the first viewport beneath the desktop header. */
@media (min-width: 1081px) {
  .hero {
    min-height: calc(100svh - 78px);
    display: flex;
    align-items: center;
  }
  .hero-content { width: 100%; padding-block: 52px 64px; }
}
/* Editorial art chosen by the project owner */
.editorial-card img { object-fit: cover; object-position: center; opacity: .82; }
.editorial-card:before { z-index: 1; background: linear-gradient(90deg,rgba(5,11,19,.30),rgba(5,11,19,.76) 37%,rgba(5,11,19,.90)); }
.editorial-card > div { z-index: 2; }
/* Balanced, centered credibility strip */
.proof { display: flex; align-items: center; justify-content: center; flex-wrap: wrap; gap: clamp(30px,5vw,84px); }
.proof > div { flex: 0 1 auto; min-width: 190px; justify-content: center; }
.proof b { overflow: hidden; flex: 0 0 50px; height: 50px; width: 50px; border-radius: 50%; background: #172435; }
.proof b img { display: block; width: 34px; height: 34px; object-fit: contain; }
@media (min-width: 701px) and (max-width: 1080px) {
  .hero { min-height: calc(100svh - 115px); display:flex; align-items:center; }
  .hero-content { width: 100%; }
}
@media (max-width: 700px) {
  .hero { min-height: max(690px, calc(100svh - 80px)); display: flex; align-items: center; }
  .hero-content { width: 100%; padding-block: 40px 70px; }
  .proof { justify-content: center; gap: 20px; }
  .proof > div { min-width: min(100%,270px); justify-content: flex-start; }
  .editorial-card:before { background: linear-gradient(90deg,rgba(5,11,19,.45),rgba(5,11,19,.90)); }
}
</style>

